    <!-- JavaScript Logic -->
    <script>
        // Tab switching logic
        function switchTab(tabId, btnElement) {
            // Hide all tab content
            const contents = document.querySelectorAll('.tab-content');
            contents.forEach(content => {
                content.classList.remove('active');
            });

            // Show selected tab content
            const targetContent = document.getElementById(tabId);
            if (targetContent) {
                targetContent.classList.add('active');
            }

            // Remove active classes from all tab buttons
            const buttons = document.querySelectorAll('.tab-btn');
            buttons.forEach(btn => {
                btn.classList.remove('bg-indigo-600', 'text-white', 'shadow-md');
                btn.classList.add('text-slate-400');
            });

            // Add active class to clicked button
            btnElement.classList.add('bg-indigo-600', 'text-white', 'shadow-md');
            btnElement.classList.remove('text-slate-400');
            btnElement.classList.add('text-slate-300');
        }

        // Copy to clipboard logic
        function copyToClipboard(elementId, btn) {
            const citeText = document.getElementById(elementId).innerText;
            navigator.clipboard.writeText(citeText).then(() => {
                // Visual feedback
                const originalHtml = btn.innerHTML;
                btn.innerHTML = '<i class="fa-solid fa-check text-green-400 mr-1"></i> 복사 완료';
                btn.classList.add('border-green-500/50', 'text-green-400');
                
                setTimeout(() => {
                    btn.innerHTML = originalHtml;
                    btn.classList.remove('border-green-500/50', 'text-green-400');
                }, 2000);
            }).catch(err => {
                console.error('Copy failed: ', err);
            });
        }

        // Live search and filter for Master Reference list
        function filterTable() {
            const input = document.getElementById('search-input');
            const filter = input.value.toLowerCase();
            const cards = document.querySelectorAll('.ref-card');

            cards.forEach(card => {
                const searchText = card.getAttribute('data-search').toLowerCase();
                // Or search paragraph text inside
                const cardContent = card.innerText.toLowerCase();
                
                if (searchText.indexOf(filter) > -1 || cardContent.indexOf(filter) > -1) {
                    card.style.display = "";
                } else {
                    card.style.display = "none";
                }
            });
        }
        // Close PDF Viewer function
        function closePdfViewer(viewerId, btnId) {
            const viewer = document.getElementById(viewerId);
            viewer.classList.add('hidden');
            const btn = document.getElementById(btnId);
            if (btn) {
                // Reset to default styling string directly
                btn.className = "bg-indigo-950/50 text-indigo-300 hover:bg-indigo-900/50 px-2.5 py-1 rounded border border-indigo-900/50 transition flex items-center space-x-1";
            }
        }

        // Go to specific reference tab & card with scroll & highlight
        function goToReference(refId) {
            // Get reference tab button and click it
            const refTabBtn = document.getElementById('btn-tab-references');
            if (refTabBtn) {
                switchTab('tab-references', refTabBtn);
            }
            
            // Scroll to the card and trigger a temporary highlight ring
            setTimeout(() => {
                const viewer = document.getElementById('pdf-viewer-' + refId);
                if (viewer) {
                    const card = viewer.closest('.ref-card');
                    if (card) {
                        card.scrollIntoView({ behavior: 'smooth', block: 'center' });
                        // Add highlight classes
                        card.classList.remove('border-slate-800');
                        card.classList.add('ring-2', 'ring-indigo-500', 'border-indigo-500');
                        
                        setTimeout(() => {
                            card.classList.remove('ring-2', 'ring-indigo-500', 'border-indigo-500');
                            card.classList.add('border-slate-800');
                        }, 2500);
                    }
                }
            }, 150);
        }

        // Inline PDF Viewer toggle function
        function togglePdfViewer(viewerId, pdfUrl, btnElement) {
            const viewer = document.getElementById(viewerId);
            const iframe = viewer.querySelector('iframe');
            
            if (viewer.classList.contains('hidden')) {
                // Open and set src if empty
                if (!iframe.src || iframe.src === 'about:blank' || iframe.src === window.location.href) {
                    iframe.src = pdfUrl;
                }
                viewer.classList.remove('hidden');
                // Set active styling string directly
                btnElement.className = "bg-indigo-600 text-white hover:bg-indigo-500 px-2.5 py-1 rounded border border-indigo-900/50 transition flex items-center space-x-1";
            } else {
                viewer.classList.add('hidden');
                // Reset to default styling string directly
                btnElement.className = "bg-indigo-950/50 text-indigo-300 hover:bg-indigo-900/50 px-2.5 py-1 rounded border border-indigo-900/50 transition flex items-center space-x-1";
            }
        }
    </script>
</body>
</html>
